<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <!-- КОНТЕЙНЕР ДЛЯ ФРАГМЕНТОВ (занимает всё оставшееся место справа) -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/fragment_container"
        android:name="org.top.economic.MainFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>


    <LinearLayout
        android:id="@+id/left_menu_bar"
        android:layout_width="64dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@android:color/transparent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        >

        <!-- BURGER -->
        <ImageButton
            android:id="@+id/btn_burger_land"
            android:layout_width="64dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_burger_menu"
            android:scaleType="centerInside"
            android:contentDescription="Меню"/>

        <!-- ВСТРОЕННОЕ МЕНЮ -->
        <com.google.android.material.navigationrail.NavigationRailView
            android:id="@+id/menu"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"

            android:fitsSystemWindows="false"

            android:background="@android:color/transparent"

            app:elevation="0dp"

            app:menu="@menu/bottom_nav_menu"

            app:labelVisibilityMode="unlabeled"

            app:itemIconSize="25dp"

            app:itemMinHeight="44dp"
            app:itemSpacing="10dp"

            app:itemPaddingTop="0dp"
            app:itemPaddingBottom="0dp"

            app:menuGravity="top"

            app:contentMarginTop="0dp"

            app:scrollingEnabled="true"
            app:itemActiveIndicatorStyle="@style/CompactIndicatorStyle" />

    </LinearLayout>

    <!-- РАСКРЫВАЮЩЕЕСЯ МЕНЮ (По умолчанию скрыто: visibility="gone") -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/expanded_navigation_view"
        android:layout_width="240dp"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:elevation="8dp"
        android:background="?android:attr/windowBackground"
        app:menu="@menu/bottom_nav_menu"
        app:itemIconSize="25dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />


    <!-- 3. КАСТОМНОЕ РАЗВЕРНУТОЕ МЕНЮ (Выезжает поверх всего слева) -->
    <!-- Устанавливаем фиксированную ширину, скругляем углы справа через CardView -->
    <androidx.cardview.widget.CardView
        android:id="@+id/expanded_menu_panel"
        android:layout_width="360dp"
        android:layout_height="match_parent"
        android:translationX="-360dp"
        android:visibility="gone"
        app:cardCornerRadius="24dp"
        app:cardElevation="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Внутренняя разметка вашего меню (как на фото) -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:background="#FFFFFF">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="20dp">

                <!-- КРЕСТИК ЗАКРЫТИЯ (вверху справа) -->
                <ImageButton
                    android:id="@+id/btn_close_menu"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_close"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <!-- ТУТ ВАША СТРУКТУРА: Профиль Мурчика, Баланс 640 монет, Колонки Игра/Обучение -->
                <!-- Пример структуры элементов: -->
                <ImageView
                    android:id="@+id/avatar"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_murchik_avatar"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"/>

                <TextView
                    android:id="@+id/username"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Мурчик"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#22123B"
                    android:layout_marginStart="12dp"
                    app:layout_constraintTop_toTopOf="@id/avatar"
                    app:layout_constraintStart_toEndOf="@id/avatar"/>

                <!-- Сверстайте остальные текстовые кнопки в два столбца ниже... -->

            </androidx.constraintlayout.widget.ConstraintLayout>
        </ScrollView>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
