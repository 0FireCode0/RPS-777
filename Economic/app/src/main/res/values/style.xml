<resources>
    <style name="TextViewStyleNight">
        <item name="android:textColor">@android:color/white</item>
    </style>
    <style name="CompactIndicatorStyle" parent="">
        <item name="android:width">34dp</item>
        <item name="android:height">34dp</item>
        <item name="marginHorizontal">10dp</item>
        <item name="android:color">#6B5BE4</item>
        <item name="shapeAppearance">@style/CompactIndicatorShape</item>
    </style>
    <style name="CompactIndicatorStyleVertical" parent="">
        <item name="android:width">50dp</item>
        <item name="android:height">50dp</item>
        <item name="marginHorizontal">0dp</item>
        <item name="android:color">#6B5BE4</item>
        <item name="shapeAppearance">@style/CompactIndicatorShape</item>
    </style>

    <style name="CompactIndicatorShape" parent="ShapeAppearance.Material3.Corner.Small">
        <item name="cornerSize">6dp</item>
    </style>

    <style name="BottomMenuText" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">16sp</item>
    </style>
</resources>
