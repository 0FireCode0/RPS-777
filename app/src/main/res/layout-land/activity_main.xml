<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <!-- КОНТЕЙНЕР ДЛЯ ФРАГМЕНТОВ (занимает всё оставшееся место справа) -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/fragment_container"
        android:name="org.top.economic.MainFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>


    <LinearLayout
        android:id="@+id/left_menu_bar"
        android:layout_width="64dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@android:color/transparent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="25dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        >

        <!-- BURGER -->
        <ImageButton
            android:id="@+id/btn_burger_land"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_burger_menu"
            android:scaleType="centerInside"
            android:contentDescription="Меню"/>

        <!-- ВСТРОЕННОЕ МЕНЮ -->
        <com.google.android.material.navigationrail.NavigationRailView
            android:id="@+id/menu"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"

            android:fitsSystemWindows="false"

            android:background="@android:color/transparent"

            app:elevation="0dp"

            app:menu="@menu/bottom_nav_menu"

            app:labelVisibilityMode="unlabeled"

            app:itemIconSize="25dp"

            app:itemMinHeight="44dp"
            app:itemSpacing="10dp"

            app:itemPaddingTop="0dp"
            app:itemPaddingBottom="0dp"

            app:menuGravity="top"

            app:contentMarginTop="0dp"

            app:scrollingEnabled="true"
            app:itemActiveIndicatorStyle="@style/CompactIndicatorStyle" />

    </LinearLayout>

    <!-- ЗАТЕМНЕНИЕ -->
    <View
        android:id="@+id/menu_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#611E1B29"
        android:visibility="gone"
        android:elevation="20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />


    <!-- ВЫДВИЖНАЯ ПАНЕЛЬ -->
    <androidx.cardview.widget.CardView
        android:id="@+id/expanded_menu_panel"
        android:layout_width="356dp"
        android:layout_height="match_parent"
        android:translationX="-356dp"
        android:visibility="gone"
        android:elevation="21dp"

        app:cardCornerRadius="24dp"
        app:cardElevation="24dp"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:background="#FFFFFF"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/shell_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="35dp"
                android:paddingEnd="14dp"
                android:paddingTop="12dp"
                android:paddingBottom="14dp">

                <!-- ========================= -->
                <!-- ШАПКА -->
                <!-- ========================= -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:id="@+id/menu_avatar"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:src="@drawable/ic_murchik_avatar"
                        android:scaleType="centerCrop" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="9dp">

                        <TextView
                            android:id="@+id/name_animal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Мурчик"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#22123B"
                            android:maxLines="1" />

                        <TextView
                            android:id="@+id/name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Аня"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="#77737F"
                            android:maxLines="1" />

                    </LinearLayout>

                    <ImageButton
                        android:id="@+id/btn_close_menu"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_close"
                        android:scaleType="centerInside"
                        android:contentDescription="Закрыть" />

                </LinearLayout>


                <!-- ========================= -->
                <!-- МОНЕТЫ -->
                <!-- ========================= -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="#FBEEDE"
                    android:paddingStart="11dp"
                    android:paddingEnd="11dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_coin" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="7dp"
                        android:text="Всего монет"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#8A5A12" />

                    <TextView
                        android:id="@+id/money_menu"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="640"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#7A4E0B" />

                </LinearLayout>


                <!-- ========================= -->
                <!-- ДВЕ КОЛОНКИ -->
                <!-- ========================= -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    android:baselineAligned="false">

                    <!-- ЛЕВАЯ КОЛОНКА -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ИГРА"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="#77737F"
                            android:layout_marginStart="9dp"
                            android:layout_marginTop="7dp"
                            android:layout_marginBottom="3dp" />

                        <!-- СЮДА JAVA ДОБАВИТ ИГРУ -->
                        <LinearLayout
                            android:id="@+id/shell_game_container"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />


                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ДЕНЬГИ"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="#77737F"
                            android:layout_marginStart="9dp"
                            android:layout_marginTop="7dp"
                            android:layout_marginBottom="3dp" />

                        <!-- СЮДА JAVA ДОБАВИТ ДЕНЬГИ -->
                        <LinearLayout
                            android:id="@+id/shell_money_container"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />

                    </LinearLayout>


                    <!-- ПРАВАЯ КОЛОНКА -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ОБУЧЕНИЕ"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="#77737F"
                            android:layout_marginStart="9dp"
                            android:layout_marginTop="7dp"
                            android:layout_marginBottom="3dp" />

                        <!-- СЮДА JAVA ДОБАВИТ ОБУЧЕНИЕ -->
                        <LinearLayout
                            android:id="@+id/shell_education_container"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />


                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ЕЩЁ"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="#77737F"
                            android:layout_marginStart="9dp"
                            android:layout_marginTop="7dp"
                            android:layout_marginBottom="3dp" />

                        <!-- СЮДА JAVA ДОБАВИТ "ЕЩЁ" -->
                        <LinearLayout
                            android:id="@+id/shell_other_container"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </ScrollView>

    </androidx.cardview.widget.CardView>


</androidx.constraintlayout.widget.ConstraintLayout>
