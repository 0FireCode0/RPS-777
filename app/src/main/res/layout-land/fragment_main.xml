                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="20"
                    android:textColor="#87838E"
                    android:textSize="9sp"
                    android:textStyle="bold" />

            </LinearLayout>


